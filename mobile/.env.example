# Copy to .env.local and fill in. Without these the app runs in local-only mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Comma separated: apple,google (only those enabled in Supabase Auth)
EXPO_PUBLIC_OAUTH_PROVIDERS=
# Strava import (Client ID is public; the secret is set only as a Supabase secret)
EXPO_PUBLIC_STRAVA_CLIENT_ID=
# EXPO_PUBLIC_STRAVA_REDIRECT_URI=runner://strava-callback
# Required for maps on Android
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional
APP_BUNDLE_ID=app.runner.mobile
# Apple Developer team ID for installing on a physical iPhone
APPLE_TEAM_ID=
# Expo/EAS project id — enables push notifications (npx eas-cli init)
EAS_PROJECT_ID=
